        <mxCell id="c222" parent="1" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#D13212;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;fontStyle=1;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.sqs;" value="SQS &lt;b&gt;(DLQ)&lt;/b&gt;&lt;br&gt;&lt;b&gt;cola-notificaciones-entrevistas-dlq-dev&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:8px;color:#666'&gt;Retención: 14 días (1 209 600 s)&lt;/font&gt;" vertex="1">
          <mxGeometry height="45" width="45" x="970" y="2767" as="geometry" />
