        <mxCell id="c225" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff5f5;strokeColor=#D13212;fontSize=9;align=left;spacingLeft=8;verticalAlign=middle;" value="&lt;b&gt;Gestión e inspección de mensajes en DLQ (Consola AWS):&lt;/b&gt;&lt;br&gt;• &lt;b&gt;Poll for messages:&lt;/b&gt; Inspección forense de mensajes corruptos/no soportados (ej. &lt;font face=&#39;Courier New&#39;&gt;&amp;quot;evento&amp;quot;: &amp;quot;prueba_dlq&amp;quot;&lt;/font&gt;)&lt;br&gt;• &lt;b&gt;CloudWatch Logs:&lt;/b&gt; Verificación de trazas de error con &lt;font face=&#39;Courier New&#39;&gt;&amp;quot;Evento no soportado: prueba_dlq&amp;quot;&lt;/font&gt; (3 intentos)&lt;br&gt;• &lt;b&gt;Recuperación / Limpieza:&lt;/b&gt; &lt;i&gt;Start DLQ redrive&lt;/i&gt; (re-inyección a cola origen) o &lt;i&gt;Purge / Delete&lt;/i&gt; tras depurar" vertex="1">
          <mxGeometry height="88" width="395" x="1220" y="2758.5" as="geometry" />
        </mxCell>
        <mxCell id="c227" parent="1" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#fffcfd;strokeColor=#D13212;verticalAlign=top;align=left;spacingLeft=10;fontSize=10;" value="&lt;b&gt;Ficha Técnica: Implementación DLQ en Microservicio Entrevistas (MS4 · cs2032-entrevistas)&lt;/b&gt;&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;div&gt;&lt;table style=&quot;font-size:9px;margin-top:4px;&quot; cellpadding=&quot;2&quot; cellspacing=&quot;0&quot;&gt;&lt;tbody&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;• Cola DLQ:&lt;/b&gt;&lt;/td&gt;&lt;td&gt;&lt;font face=&quot;Courier New&quot;&gt;cola-notificaciones-entrevistas-dlq-dev&lt;/font&gt; (Standard · us-east-1)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;• Retención de Mensajes:&lt;/b&gt;&lt;/td&gt;&lt;td&gt;14 días (&lt;font face=&quot;Courier New&quot;&gt;MessageRetentionPeriod: 1209600&lt;/font&gt;) — plazo máximo para revisión manual&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;• Redrive Policy:&lt;/b&gt;&lt;/td&gt;&lt;td&gt;&lt;font face=&quot;Courier New&quot;&gt;maxReceiveCount: 3&lt;/font&gt; (1 intento normal + 2 reintentos con VisibilityTimeout de 60 s)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;• Mecanismo en Lambda:&lt;/b&gt;&lt;/td&gt;&lt;td&gt;&lt;font face=&quot;Courier New&quot;&gt;ReportBatchItemFailures&lt;/font&gt; activo; solo los mensajes fallidos vuelven a la cola&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;• Prueba de Forzado:&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Publicación SNS con &lt;font face=&quot;Courier New&quot;&gt;evento != &quot;entrevista_agendada&quot;&lt;/font&gt; deriva a DLQ tras 3-4 minutos&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;• Operación &amp;amp; IaC:&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Re-inyección vía &lt;i&gt;Start DLQ redrive&lt;/i&gt; · Soporte en &lt;font face=&quot;Courier New&quot;&gt;serverless.yml&lt;/font&gt; (recursos CloudFormation)&lt;/td&gt;&lt;/tr&gt;&lt;/tbody&gt;&lt;/table&gt;&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="165" width="690" x="1030" y="2873" as="geometry" />
        </mxCell>
      </root>
