        <mxCell id="c224" edge="1" parent="1" source="c222" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.2;fontSize=9;labelBackgroundColor=#ffffff;strokeColor=#147EBA;dashed=1;entryX=1;entryY=0.7;" target="c177" value="&lt;font color='#147EBA'&gt;&lt;b&gt;Start DLQ redrive&lt;/b&gt;&lt;br&gt;(reproceso manual a cola origen)&lt;/font&gt;">
          <mxGeometry relative="1" x="-0.1794" as="geometry">
            <mxPoint as="offset" />
            <Array as="points">
              <mxPoint x="1080" y="2789.51" />
