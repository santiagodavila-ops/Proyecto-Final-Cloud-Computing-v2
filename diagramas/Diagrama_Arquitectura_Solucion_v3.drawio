        <mxCell id="c223" edge="1" parent="1" source="c177" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=9;labelBackgroundColor=#ffffff;strokeColor=#D13212;" target="c222" value="&lt;font color='#D13212'&gt;&lt;b&gt;Redrive Policy&lt;/b&gt;&lt;br&gt;(al 3er fallo consecutivo)&lt;/font&gt;">
          <mxGeometry relative="1" x="0.168" as="geometry">
