# =================================================================
# Plantilla de Configuración de Entorno Local (.env.example)
# Copia este archivo a despliegue/.env.local y define tus variables
# NUNCA subas credenciales reales al control de versiones.
# =================================================================

# Credenciales de base de datos MySQL (RDS)
export DB_PASSWORD="TU_PASSWORD_AQUI"
export RDS_SG_IDS="sg-xxxxxxxxxxxxxxxxx"
export RDS_SUBNET_IDS="subnet-xxxx,subnet-yyyy"
export RDS_VPC_ID="vpc-xxxxxxxxxxxxxxxxx"
export RDS_ROUTE_TABLE_IDS="rtb-xxxxxxxxxxxxxxxxx"
export RDS_HOST="cs2032-vacantes-dev.xxxx.us-east-1.rds.amazonaws.com"

# Contraseña maestra del administrador inicial (seed)
export ADMIN_PASSWORD="TU_ADMIN_PASSWORD"

# URLs base de los 5 microservicios REST desplegados en API Gateway
export API_USUARIOS="https://xxxxxxxxxx.execute-api.us-east-1.amazonaws.com/dev"
export API_CANDIDATOS="https://xxxxxxxxxx.execute-api.us-east-1.amazonaws.com/dev"
export API_VACANTES="https://xxxxxxxxxx.execute-api.us-east-1.amazonaws.com/dev"
export API_ENTREVISTAS="https://xxxxxxxxxx.execute-api.us-east-1.amazonaws.com/dev"
export API_REPORTES="https://xxxxxxxxxx.execute-api.us-east-1.amazonaws.com/dev"

# Correo electrónico para alertas y notificaciones operativas CloudWatch / SNS
export ALERT_EMAIL="usuario@ejemplo.com"
