        <mxCell id="c189" parent="1" style="text;html=1;align=center;" value="&lt;font style='font-size:9px'&gt;sls deploy --stage dev/test/prod&lt;br&gt;Rol IAM: LabRole&lt;/font&gt;" vertex="1">
