        <mxCell id="c225" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff5f5;strokeColor=#D13212;fontSize=9;align=left;spacingLeft=8;verticalAlign=middle;" value="&lt;b&gt;Gestión e inspección de mensajes en DLQ (Consola AWS):&lt;/b&gt;&lt;br&gt;• &lt;b&gt;Poll for messages:&lt;/b&gt; Inspección forense de mensajes corruptos/no soportados (ej. &lt;font face='Courier New'&gt;&amp;quot;evento&amp;quot;: &amp;quot;prueba_dlq&amp;quot;&lt;/font&gt;)&lt;br&gt;• &lt;b&gt;CloudWatch Logs:&lt;/b&gt; Verificación de trazas de error con &lt;font face='Courier New'&gt;&amp;quot;Evento no soportado: prueba_dlq&amp;quot;&lt;/font&gt; (3 intentos)&lt;br&gt;• &lt;b&gt;Recuperación / Limpieza:&lt;/b&gt; &lt;i&gt;Start DLQ redrive&lt;/i&gt; (re-inyección a cola origen) o &lt;i&gt;Purge / Delete&lt;/i&gt; tras depurar" vertex="1">
          <mxGeometry height="88" width="395" x="1220" y="2758.5" as="geometry" />
        </mxCell>
        <mxCell id="c227" parent="1" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#fffcfd;strokeColor=#D13212;verticalAlign=top;align=left;spacingLeft=10;fontSize=10;" value="&lt;b&gt;Ficha Técnica: Arquitectura Enterprise v3 (AWS Well-Architected Framework · CS2032)&lt;/b&gt;&lt;br&gt;&#10;&lt;table style='font-size:8.5px;margin-top:4px;' cellpadding='2' cellspacing='0'&gt;&#10;&lt;tr&gt;&lt;td&gt;&lt;b&gt;• Seguridad Perimetral:&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Lambda Authorizer (&lt;font face='Courier New'&gt;cs2032-usuarios-dev-authorizer&lt;/font&gt;) con caché TTL de 300 s en las 5 APIs REST; inyección de &lt;font face='Courier New'&gt;tenant_id, usuario_id, rol&lt;/font&gt;.&lt;/td&gt;&lt;/tr&gt;&#10;&lt;tr&gt;&lt;td&gt;&lt;b&gt;• Gestión de Secretos:&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Credenciales RDS migradas a &lt;font face='Courier New'&gt;/cs2032/dev/rds/*&lt;/font&gt; (SecureString KMS); VPC Endpoints SSM/KMS privados; caché en memoria cold-start.&lt;/td&gt;&lt;/tr&gt;&#10;&lt;tr&gt;&lt;td&gt;&lt;b&gt;• Resiliencia EDA (DLQ):&lt;/b&gt;&lt;/td&gt;&lt;td&gt;&lt;font face='Courier New'&gt;cola-notificaciones-entrevistas-dlq-dev&lt;/font&gt; (retención 14 días); Redrive Policy (&lt;font face='Courier New'&gt;maxReceiveCount: 3&lt;/font&gt;); retorno vía &lt;i&gt;Start DLQ redrive&lt;/i&gt;.&lt;/td&gt;&lt;/tr&gt;&#10;&lt;tr&gt;&lt;td&gt;&lt;b&gt;• Observabilidad &amp;amp; Alarmas:&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Suite de 6 alarmas CloudWatch (DLQ, 5XX, Errores Lambda, Throttles, CPU RDS, Conexiones RDS) con despacho a SNS (&lt;font face='Courier New'&gt;topico-alertas-cloudwatch-dev&lt;/font&gt;).&lt;/td&gt;&lt;/tr&gt;&#10;&lt;tr&gt;&lt;td&gt;&lt;b&gt;• Dashboard Central:&lt;/b&gt;&lt;/td&gt;&lt;td&gt;&lt;font face='Courier New'&gt;dashboard-cs2032-dev&lt;/font&gt; con 11 widgets en tiempo real (estado de alarmas, colas, tráfico API, latencia, métricas RDS).&lt;/td&gt;&lt;/tr&gt;&#10;&lt;tr&gt;&lt;td&gt;&lt;b&gt;• Trazabilidad Distribuida:&lt;/b&gt;&lt;/td&gt;&lt;td&gt;AWS X-Ray activo en 32 funciones Lambda y 5 API Gateways con propagación de cabeceras &lt;font face='Courier New'&gt;X-Amzn-Trace-Id&lt;/font&gt; y Service Map.&lt;/td&gt;&lt;/tr&gt;&#10;&lt;/table&gt;" vertex="1">
          <mxGeometry height="180" width="690" x="1030" y="2873" as="geometry" />
        </mxCell>
      <mxCell id="c228" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f3e8ff;strokeColor=#8C4FFF;strokeWidth=1.5;align=center;verticalAlign=middle;fontSize=9;fontColor=#232F3E;" value="&lt;b&gt;Lambda Authorizer&lt;/b&gt;&lt;br&gt;&lt;font face='Courier New' style='font-size:9px'&gt;cs2032-usuarios-dev-authorizer&lt;/font&gt;&lt;br&gt;&lt;font color='#8C4FFF'&gt;&lt;b&gt;Token Authorizer · Caché 300 s&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:8px;color:#666'&gt;Inyecta context: tenant_id, usuario_id, rol&lt;/font&gt;" vertex="1"><mxGeometry x="500" y="360" width="155" height="75" as="geometry" /></mxCell><mxCell id="c229" edge="1" parent="1" source="c228" target="c38" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#8C4FFF;dashed=1;labelBackgroundColor=#ffffff;fontSize=9;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" value="&lt;font color='#8C4FFF'&gt;&lt;b&gt;Valida Bearer&lt;/b&gt;&lt;br&gt;(GetItem t_tokens_acceso · TTL 300s)&lt;/font&gt;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="675" y="460" /><mxPoint x="1180" y="460" /><mxPoint x="1180" y="307" /></Array></mxGeometry></mxCell><mxCell id="c230" edge="1" parent="1" source="c25" target="c228" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.2;strokeColor=#8C4FFF;dashed=1;labelBackgroundColor=#ffffff;fontSize=9;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" value="&lt;font color='#8C4FFF'&gt;token check&lt;/font&gt;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c231" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#16a34a;strokeWidth=1.2;align=center;verticalAlign=middle;fontSize=9;fontColor=#232F3E;" value="&lt;b&gt;VPC Endpoints (Interface)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:8px'&gt;com.amazonaws.us-east-1.ssm&lt;br&gt;com.amazonaws.us-east-1.kms&lt;br&gt;Resolución privada (sin NAT Gateway)&lt;/font&gt;" vertex="1"><mxGeometry x="1085" y="1075" width="170" height="60" as="geometry" /></mxCell><mxCell id="c232" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;strokeWidth=1.5;align=center;verticalAlign=middle;fontSize=9;fontColor=#232F3E;" value="&lt;b&gt;AWS Systems Manager&lt;/b&gt;&lt;br&gt;Parameter Store (&lt;font face='Courier New'&gt;/cs2032/dev/rds/*&lt;/font&gt;)&lt;br&gt;&lt;font style='font-size:8px;color:#166534'&gt;&lt;b&gt;Cifrado KMS (SecureString)&lt;/b&gt;&lt;br&gt;Caché en memoria cold-start (0 ms warm)&lt;br&gt;0 contraseñas en variables de entorno&lt;/font&gt;" vertex="1"><mxGeometry x="1085" y="1150" width="170" height="75" as="geometry" /></mxCell><mxCell id="c233" edge="1" parent="1" source="c65" target="c231" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.2;strokeColor=#16a34a;dashed=1;labelBackgroundColor=#ffffff;fontSize=9;exitX=1;exitY=0.25;entryX=0;entryY=0.5;" value="&lt;font color='#16a34a'&gt;GetParameters&lt;/font&gt;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c234" edge="1" parent="1" source="c231" target="c232" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.2;strokeColor=#16a34a;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" value=""><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c235" edge="1" parent="1" source="c232" target="c99" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#16a34a;labelBackgroundColor=#ffffff;fontSize=9;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" value="&lt;font color='#16a34a'&gt;&lt;b&gt;Credenciales seguras&lt;/b&gt;&lt;/font&gt;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c236" parent="1" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#0284c7;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=15;fontSize=12;dashed=1;" value="&lt;b&gt;Capa de Observabilidad, Monitoreo y Trazabilidad Distribuida (AWS Well-Architected)&lt;/b&gt; — &lt;font color='#7AA116'&gt;100% Implementado y Verificado en dev&lt;/font&gt;" vertex="1"><mxGeometry x="250" y="3070" width="1470" height="440" as="geometry" /></mxCell><mxCell id="c237" parent="1" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#0284c7;verticalAlign=top;align=left;spacingLeft=10;fontSize=10;" value="&lt;b&gt;AWS X-Ray · Trazabilidad Distribuida End-to-End&lt;/b&gt;&lt;br&gt;&#10;&lt;table style='font-size:9px;margin-top:6px;' cellpadding='3' cellspacing='0'&gt;&#10;&lt;tr&gt;&lt;td&gt;&lt;b&gt;• 32 Funciones Lambda:&lt;/b&gt;&lt;/td&gt;&lt;td&gt;&lt;font color='#0284c7'&gt;&lt;b&gt;TracingConfig Mode = Active&lt;/b&gt;&lt;/font&gt; (100% funciones de los 5 microservicios)&lt;/td&gt;&lt;/tr&gt;&#10;&lt;tr&gt;&lt;td&gt;&lt;b&gt;• 5 API Gateways:&lt;/b&gt;&lt;/td&gt;&lt;td&gt;&lt;font color='#0284c7'&gt;&lt;b&gt;tracingEnabled = True&lt;/b&gt;&lt;/font&gt; en stage &lt;font face='Courier New'&gt;dev&lt;/font&gt; (usuarios, vacantes, candidatos, entrevistas, reportes)&lt;/td&gt;&lt;/tr&gt;&#10;&lt;tr&gt;&lt;td&gt;&lt;b&gt;• Propagación de Trazas:&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Cabecera &lt;font face='Courier New'&gt;X-Amzn-Trace-Id&lt;/font&gt; inyectada en cada request y propagada a downstream services&lt;/td&gt;&lt;/tr&gt;&#10;&lt;tr&gt;&lt;td&gt;&lt;b&gt;• Mapa de Servicios:&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Generación automática de Service Map visualizando dependencias entre APIs, Lambdas, DynamoDB, RDS y SQS/SNS&lt;/td&gt;&lt;/tr&gt;&#10;&lt;tr&gt;&lt;td&gt;&lt;b&gt;• Análisis de Latencia:&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Desglose en cascada de cold-start vs warm-start, tiempos de ejecución y percentiles (p50, p90, p95)&lt;/td&gt;&lt;/tr&gt;&#10;&lt;tr&gt;&lt;td&gt;&lt;b&gt;• Configuración IaC:&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Declarado en &lt;font face='Courier New'&gt;serverless.yml&lt;/font&gt; (&lt;font face='Courier New'&gt;provider.tracing.lambda: true, apiGateway: true&lt;/font&gt;)&lt;/td&gt;&lt;/tr&gt;&#10;&lt;/table&gt;" vertex="1"><mxGeometry x="275" y="3105" width="450" height="385" as="geometry" /></mxCell><mxCell id="c238" parent="1" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#dc2626;verticalAlign=top;align=left;spacingLeft=10;fontSize=10;" value="&lt;b&gt;Amazon CloudWatch · Suite de 6 Alarmas Operacionales&lt;/b&gt;&lt;br&gt;&#10;&lt;table style='font-size:9px;margin-top:6px;' cellpadding='3' cellspacing='0'&gt;&#10;&lt;tr&gt;&lt;td&gt;&lt;b&gt;1. SQS DLQ Backlog:&lt;/b&gt;&lt;/td&gt;&lt;td&gt;&lt;font face='Courier New'&gt;alarma-dlq-mensajes-visibles-dev&lt;/font&gt;&lt;br&gt;Umbral: &lt;font color='#dc2626'&gt;&lt;b&gt;MessagesVisible &amp;gt;= 1&lt;/b&gt;&lt;/font&gt; · &lt;font color='#dc2626'&gt;&lt;b&gt;[ESTADO: ALARM]&lt;/b&gt;&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;&#10;&lt;tr&gt;&lt;td&gt;&lt;b&gt;2. API Gateway 5XX:&lt;/b&gt;&lt;/td&gt;&lt;td&gt;&lt;font face='Courier New'&gt;alarma-apigateway-5xx-dev&lt;/font&gt;&lt;br&gt;Umbral: Suma 5XX en 5 APIs &amp;gt;= 1 error (5 min) · &lt;font color='#16a34a'&gt;&lt;b&gt;[OK]&lt;/b&gt;&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;&#10;&lt;tr&gt;&lt;td&gt;&lt;b&gt;3. Lambda Errors:&lt;/b&gt;&lt;/td&gt;&lt;td&gt;&lt;font face='Courier New'&gt;alarma-lambda-errores-dev&lt;/font&gt;&lt;br&gt;Umbral: Errores en 8 Lambdas críticas &amp;gt;= 2 (5 min) · &lt;font color='#16a34a'&gt;&lt;b&gt;[OK]&lt;/b&gt;&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;&#10;&lt;tr&gt;&lt;td&gt;&lt;b&gt;4. Lambda Throttles:&lt;/b&gt;&lt;/td&gt;&lt;td&gt;&lt;font face='Courier New'&gt;alarma-lambda-throttles-dev&lt;/font&gt;&lt;br&gt;Umbral: Throttling / Concurrencia &amp;gt;= 1 throttle · &lt;font color='#16a34a'&gt;&lt;b&gt;[OK]&lt;/b&gt;&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;&#10;&lt;tr&gt;&lt;td&gt;&lt;b&gt;5. RDS High CPU:&lt;/b&gt;&lt;/td&gt;&lt;td&gt;&lt;font face='Courier New'&gt;alarma-rds-cpu-dev&lt;/font&gt;&lt;br&gt;Umbral: CPUUtilization MySQL &amp;gt;= 80.0% · &lt;font color='#16a34a'&gt;&lt;b&gt;[OK]&lt;/b&gt;&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;&#10;&lt;tr&gt;&lt;td&gt;&lt;b&gt;6. RDS Connections:&lt;/b&gt;&lt;/td&gt;&lt;td&gt;&lt;font face='Courier New'&gt;alarma-rds-conexiones-dev&lt;/font&gt;&lt;br&gt;Umbral: DatabaseConnections &amp;gt;= 60 (límite db.t3.micro) · &lt;font color='#16a34a'&gt;&lt;b&gt;[OK]&lt;/b&gt;&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;&#10;&lt;tr&gt;&lt;td&gt;&lt;b&gt;• Notificaciones SNS:&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Acciones automáticas hacia &lt;font face='Courier New'&gt;topico-alertas-cloudwatch-dev&lt;/font&gt; (Email)&lt;/td&gt;&lt;/tr&gt;&#10;&lt;/table&gt;" vertex="1"><mxGeometry x="750" y="3105" width="485" height="385" as="geometry" /></mxCell><mxCell id="c239" parent="1" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#7c3aed;verticalAlign=top;align=left;spacingLeft=10;fontSize=10;" value="&lt;b&gt;Amazon CloudWatch · Dashboard Centralizado&lt;/b&gt;&lt;br&gt;&#10;&lt;table style='font-size:9px;margin-top:6px;' cellpadding='3' cellspacing='0'&gt;&#10;&lt;tr&gt;&lt;td&gt;&lt;b&gt;• Dashboard Name:&lt;/b&gt;&lt;/td&gt;&lt;td&gt;&lt;font face='Courier New'&gt;dashboard-cs2032-dev&lt;/font&gt; (us-east-1)&lt;/td&gt;&lt;/tr&gt;&#10;&lt;tr&gt;&lt;td&gt;&lt;b&gt;• 11 Widgets en Vivo:&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Supervisión visual 360° en tiempo real de todos los microservicios:&lt;/td&gt;&lt;/tr&gt;&#10;&lt;tr&gt;&lt;td colspan='2'&gt;&#10;  &lt;font style='font-size:8.5px;color:#333'&gt;&#10;  • &lt;b&gt;Alarm Status Widget:&lt;/b&gt; Estado visual de las 6 alarmas operativas.&lt;br&gt;&#10;  • &lt;b&gt;SQS DLQ &amp;amp; Main:&lt;/b&gt; Mensajes visibles, in-flight, enviados y eliminados.&lt;br&gt;&#10;  • &lt;b&gt;API Gateway 4XX/5XX:&lt;/b&gt; Desagregado por servicio (Vacantes, Candidatos, etc.).&lt;br&gt;&#10;  • &lt;b&gt;API Traffic &amp;amp; Latency:&lt;/b&gt; Solicitudes y latencia promedio/integración.&lt;br&gt;&#10;  • &lt;b&gt;Lambda Invocations:&lt;/b&gt; Concurrencia y volumen por microservicio.&lt;br&gt;&#10;  • &lt;b&gt;Lambda Errors &amp;amp; Throttles:&lt;/b&gt; Errores globales y por función.&lt;br&gt;&#10;  • &lt;b&gt;Lambda Durations:&lt;/b&gt; Percentiles Average y p95.&lt;br&gt;&#10;  • &lt;b&gt;RDS Performance:&lt;/b&gt; CPU %, conexiones activas y FreeableMemory.&#10;  &lt;/font&gt;&#10;&lt;/td&gt;&lt;/tr&gt;&#10;&lt;tr&gt;&lt;td&gt;&lt;b&gt;• Script IaC:&lt;/b&gt;&lt;/td&gt;&lt;td&gt;&lt;font face='Courier New'&gt;scripts/observability/setup_cloudwatch_alarms_and_dashboard.py&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;&#10;&lt;/table&gt;" vertex="1"><mxGeometry x="1255" y="3105" width="440" height="385" as="geometry" /></mxCell></root>
    </mxGraphModel>
  </diagram>
